{
  "name": "perfectly-balanced",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @balanced/web",
    "dev:https": "LOCAL_HTTPS=true npm run dev",
    "build": "tsc --noEmit && npm run build -w @balanced/web",
    "typecheck": "tsc --noEmit",
    "test:plaid": "vitest run packages/domain/src/plaid.test.ts tests/integration/plaid.test.ts",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/plaid-api/index.ts supabase/functions/plaid-worker/index.ts supabase/functions/plaid-webhook/index.ts",
    "test:functions": "deno test --allow-env=SUPABASE_URL,APP_DEPLOYMENT_ENV,APP_ALLOWED_ORIGINS,PLAID_ENVIRONMENT,PLAID_REDIRECT_URI,PLAID_WEBHOOK_URL --config supabase/functions/deno.json supabase/functions/_shared/",
    "plaid:setup": "node scripts/plaid/setup-local.ts",
    "plaid:setup:https": "node scripts/plaid/setup-https.ts",
    "plaid:serve": "supabase functions serve --env-file supabase/.env.local",
    "plaid:schedule:local": "node --env-file=supabase/.env.local scripts/plaid/schedule.ts --local",
    "test:sandbox": "node --env-file=supabase/.env.local scripts/plaid/sandbox-smoke.ts",
    "test:sandbox:link": "node scripts/plaid/link-browser-smoke.ts",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain apps/web/src/app tests/cutover",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:hosting": "npm run build && playwright test --config playwright.production.config.ts",
    "lint": "eslint .",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "types": "supabase gen types typescript --local > packages/data/src/database.types.ts && node scripts/format-types.ts",
    "cutover": "node scripts/cutover/cli.ts",
    "cutover:rehearse": "node scripts/cutover/rehearse.ts",
    "cutover:rehearse-replacement": "node scripts/cutover/rehearse-replacement.ts"
  },
  "devDependencies": {
    "deno": "^2.5.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "supabase": "^2.50.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
