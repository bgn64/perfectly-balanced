{
  "name": "perfectly-balanced",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/container/dev.ts",
    "dev:https": "npm run dev -- --experimental-https",
    "build": "tsc --noEmit && npm run build -w @balanced/web",
    "typecheck": "tsc --noEmit",
    "test:plaid": "vitest run packages/domain/src/plaid.test.ts tests/container",
    "check:functions": "npm run typecheck",
    "test:functions": "npm run test:container",
    "legacy:check:functions": "deno check --config supabase/functions/deno.json supabase/functions/plaid-api/index.ts supabase/functions/plaid-worker/index.ts supabase/functions/plaid-webhook/index.ts",
    "legacy:test:functions": "deno test --allow-env=SUPABASE_URL,APP_DEPLOYMENT_ENV,APP_ALLOWED_ORIGINS,PLAID_ENVIRONMENT,PLAID_REDIRECT_URI,PLAID_WEBHOOK_URL --config supabase/functions/deno.json supabase/functions/_shared/",
    "legacy:plaid:setup": "node scripts/plaid/setup-local.ts",
    "legacy:plaid:setup:https": "node scripts/plaid/setup-https.ts",
    "legacy:plaid:serve": "supabase functions serve --env-file supabase/.env.local",
    "legacy:plaid:schedule:local": "node --env-file=supabase/.env.local scripts/plaid/schedule.ts --local",
    "legacy:test:sandbox": "node --env-file=supabase/.env.local scripts/plaid/sandbox-smoke.ts",
    "legacy:test:sandbox:link": "node scripts/plaid/link-browser-smoke.ts",
    "test": "vitest run packages apps/web/src tests/container tests/cutover",
    "test:unit": "vitest run packages/domain apps/web/src tests/cutover tests/container",
    "test:container": "vitest run tests/container",
    "db:migrate": "node --env-file-if-exists=.env scripts/container/migrate.ts",
    "account:create": "node --env-file-if-exists=.env scripts/container/account.ts create",
    "account:reset": "node --env-file-if-exists=.env scripts/container/account.ts reset",
    "budget:import": "node --env-file-if-exists=.env scripts/container/import.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/container/backup.ts",
    "test:db": "npm run test:container",
    "legacy:test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:hosting": "playwright test --config playwright.production.config.ts",
    "lint": "eslint .",
    "backend:start": "docker compose up --build -d",
    "backend:stop": "docker compose stop",
    "legacy:backend:start": "supabase start",
    "legacy:backend:stop": "supabase stop",
    "legacy:backend:reset": "supabase db reset",
    "legacy:types": "supabase gen types typescript --local > packages/data/src/database.types.ts && node scripts/format-types.ts",
    "cutover": "node --env-file-if-exists=.env scripts/container/import.ts",
    "legacy:cutover": "node scripts/cutover/cli.ts",
    "legacy:cutover:rehearse": "node scripts/cutover/rehearse.ts",
    "legacy:cutover:rehearse-replacement": "node scripts/cutover/rehearse-replacement.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "deno": "^2.5.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "supabase": "^2.50.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
