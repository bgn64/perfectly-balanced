{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run local:up",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "mockup": "vite mockup",
    "preview": "vite preview",
    "local:up": "node scripts/bootstrap-local-supabase.mjs",
    "local:reset": "npm run local:up && supabase db reset --local --yes && node scripts/bootstrap-local-supabase.mjs",
    "local:down": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "supabase": "2.116.0-beta.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0-rc.2"
  }
}
