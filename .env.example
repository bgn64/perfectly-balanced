# Copy to .env in the repository root; never commit populated environment files.
APP_ENV=local
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/perfectly-balanced.sqlite
PLAID_ENABLED=false
PLAID_ENVIRONMENT=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PLAID_TOKEN_KEY=
PLAID_POLL_HOURS=6
