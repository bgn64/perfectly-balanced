# Public application settings. Values beginning with VITE_ are included in the browser bundle.
VITE_APP_NAME=Invite Only App
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=http://localhost:5173

# `npm run dev` generates .env.development.local with isolated local Supabase
# values. It is not loaded by production builds.
# Do not enable this mode for a remote or production Supabase project.
VITE_LOCAL_DEMO_MODE=false
